NODE_ENV=development
PORT=4006
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:5173
SHUTDOWN_TIMEOUT_MS=10000

# Shared local stack (ecommerce-infrastructure):
DATABASE_URL=postgresql://notification_svc:notification_local_pw@localhost:5432/notification_db
# Standalone (this repo: docker compose up -d):
# DATABASE_URL=postgresql://notification_svc:notification_local_pw@localhost:5446/notification_db
TEST_DATABASE_URL=postgresql://notification_svc:notification_local_pw@localhost:5432/notification_test

# Incoming tokens
JWKS_URL=http://localhost:4001/.well-known/jwks.json
JWT_ISSUER=ecommerce-auth-service
JWT_AUDIENCE=ecommerce-api
JWT_SERVICE_AUDIENCE=ecommerce-notification-service
TRANSACTIONAL_CALLERS=ecommerce-auth-service   # service-token subjects allowed to send secret-bearing mail

# Channels
SMTP_HOST=localhost
SMTP_PORT=1025                                 # Mailpit; UI at http://localhost:8025
SMTP_SECURE=false                              # production requires TLS (refused otherwise)
# SMTP_USER=
# SMTP_PASSWORD=                               # from Secrets Manager outside local dev
EMAIL_FROM="Shop <no-reply@shop.local>"
SMS_PROVIDER=console
ADMIN_ALERT_EMAILS=ops@shop.local
SHOP_BASE_URL=http://localhost:5173

# Delivery (exponential backoff, full jitter)
DELIVERY_INTERVAL_MS=1000
MAX_ATTEMPTS=6
RETRY_BASE_MS=30000
RETRY_CAP_MS=3600000
DELIVERY_LEASE_MS=60000

# Messaging (Floci locally)
MESSAGING_ENABLED=true
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
COMMANDS_QUEUE_NAME=local-ecommerce-notification-commands
INBOX_QUEUE_NAME=local-ecommerce-notification-inbox
DLQ_NAMES=local-ecommerce-notification-commands-dlq,local-ecommerce-notification-inbox-dlq
DLQ_CHECK_INTERVAL_MS=60000
CONSUMER_WAIT_TIME_SECONDS=20
TEST_AWS_ENDPOINT_URL=http://localhost:4566
